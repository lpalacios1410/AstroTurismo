---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Astraea Expeditions — Stargazing Expeditions' } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-celestial-bg text-white scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Astraea Expeditions lleva a viajeros a los cielos más oscuros del planeta para observar auroras boreales, lluvias de meteoros, eclipses y la Vía Láctea."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body
    class="font-sans antialiased selection:bg-celestial-teal selection:text-celestial-bg"
  >
    <slot />
  </body>
</html>
