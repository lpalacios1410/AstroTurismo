---
const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Expediciones',
    links: [
      { href: '#destinos', label: 'Destinos' },
      { href: '#visor', label: 'Visor de constelaciones' },
      { href: '#experiencia', label: 'La experiencia' },
      { href: '#reservar', label: 'Reservar' },
    ],
  },
  {
    heading: 'Compañía',
    links: [
      { href: '#', label: 'Sobre Astraea' },
      { href: '#', label: 'Ciencia y cielo' },
      { href: '#', label: 'Sostenibilidad' },
    ],
  },
  {
    heading: 'Contacto',
    links: [
      { href: 'mailto:hola@astraea.example', label: 'hola@astraea.example' },
      { href: '#', label: 'Búscanos al norte' },
    ],
  },
];
---

<footer
  class="relative mt-24 border-t border-white/10 bg-celestial-card/40 backdrop-blur-xl"
>
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 2c.9 5.4 4.6 9.1 10 10-5.4.9-9.1 4.6-10 10-.9-5.4-4.6-9.1-10-10 5.4-.9 9.1-4.6 10-10Z"
              fill="#00F5FF"
            />
          </svg>
          <span class="flex flex-col leading-none">
            <span class="font-display text-base font-bold tracking-wide text-white"
              >Astraea</span
            >
            <span class="label-sm text-celestial-muted">Expeditions</span>
          </span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-celestial-muted">
          Expediciones de astroturismo a los cielos más oscuros del planeta.
          Observa auroras, meteoros y la Vía Láctea como se veían hace diez mil
          años.
        </p>
        <p class="mt-6 flex items-center gap-2 text-xs text-celestial-muted">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-celestial-teal shadow-neon-teal"></span>
          Operamos bajo cielos Bortle clase 1 y 2
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-3 md:col-span-7">
        {
          columns.map((col) => (
            <div>
              <h3 class="label-sm text-celestial-purple">{col.heading}</h3>
              <ul class="mt-4 space-y-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-celestial-muted transition-colors duration-300 hover:text-celestial-teal"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row sm:items-center"
    >
      <p class="text-xs text-celestial-muted">
        © {year} Astraea Expeditions. Hecho bajo un cielo Bortle 1.
      </p>
      <p class="hud-tnum text-xs text-celestial-muted">
        68.9630°N · 19.0178°E — Lofoten, Noruega
      </p>
    </div>
  </div>
</footer>
